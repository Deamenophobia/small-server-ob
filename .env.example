# Copy to .env. No billing queries run until you click Refresh billing.
# AWS: configure an authenticated read-only local AWS profile first.
LOOKOUT_AWS_BILLING=0
LOOKOUT_AWS_PROFILE=lookout-billing
# DigitalOcean: use a private file outside this repository, with billing:read scope.
# LOOKOUT_DO_TOKEN_FILE=C:/Users/YOUR_NAME/.config/lookout/do-token.txt

# Optional operational configuration (no secrets):
# LOOKOUT_CONFIG=C:/path/to/lookout.config.json
# PORT=4310
# LOOKOUT_DATA_DIR=C:/path/to/private/lookout-data
